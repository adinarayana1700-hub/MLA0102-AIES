def safe(board, row, col):
    for i in range(row):
        if board[i] == col:
            return False
        if abs(board[i] - col) == abs(i - row):
            return False
    return True
def solve(board, row):
    if row == 8:
        return True

    for col in range(8):
        if safe(board, row, col):
            board[row] = col
            if solve(board, row + 1):
                return True
    return False
board = [-1] * 8
solve(board, 0)
print("8 Queen Solution:")

for i in range(8):
    for j in range(8):
        if board[i] == j:
            print("Q", end=" ")
        else:
            print(".", end=" ")
    print()
