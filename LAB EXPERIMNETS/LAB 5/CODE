from collections import deque
start = (3, 3, 1)
goal = (0, 0, 0)
moves = [(1,0), (2,0), (0,1), (0,2), (1,1)]
def valid(m, c):
    return (0 <= m <= 3 and 0 <= c <= 3 and
            (m == 0 or m >= c) and
            (3-m == 0 or 3-m >= 3-c))
q = deque([(start, [])])
visited = {start}
while q:
    (m, c, boat), path = q.popleft()
    if (m, c, boat) == goal:
        for state in path + [(m, c, boat)]:
            print(state)
        break
    for x, y in moves:
        if boat == 1:
            new = (m-x, c-y, 0)
        else:
            new = (m+x, c+y, 1)
        if valid(new[0], new[1]) and new not in visited:
            visited.add(new)
            q.append((new, path + [(m, c, boat)]))
